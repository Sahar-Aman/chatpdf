# Plantilla de variables de entorno. Copia este archivo a ".env" y rellena
# los valores reales. ".env" está en .gitignore y NUNCA se sube al repositorio.

# --- Base de datos (PostgreSQL + pgvector) ---
POSTGRES_USER=chatpdf
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=chatpdf

# --- Cola (Redis) ---
REDIS_URL=redis://redis:6379/0

# --- IA (se usará en la semana 3) ---
ANTHROPIC_API_KEY=

# --- Seguridad (se usará en la semana 4) ---
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
